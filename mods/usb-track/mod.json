{
  "id": "usb-track",
  "version": "0.5",
  "title": "USB track prototype",
  "license": "GPL-2.0-or-later",
  "device": "digitakt-mk1",
  "os": "1.54",
  "description": "Single audio-track USB return with final SRC snapshots, native MIDI control link and activation gate.",
  "sources": [
    "usb_track.c",
    "src_queue.c",
    "worker.c",
    "../../control/link.c",
    "../../control/device_link.c",
    "task_worker.c",
    "core_candidate_rtos.s"
  ],
  "machines": [
    {
      "id": 121,
      "descriptor": "usb_track_machine"
    }
  ],
  "subscribe": [
    {
      "event": "ev_render_voices",
      "fn": "usb_track_render",
      "order": 20
    },
    {
      "event": "ev_tick",
      "fn": "usb_track_ui_tick",
      "order": 40
    }
  ],
  "requires": [
    "core",
    "machine-pages",
    "usb-midi"
  ],
  "resources": {
    "core": "3.0"
  },
  "defsym": {
    "CORE_RTOS_TASK_CREATE": "0x400015ac",
    "CORE_RTOS_TASK_START": "0x400015f8",
    "CORE_RTOS_SEM_INIT": "0x4000167c",
    "CORE_RTOS_SEM_WAIT": "0x400016fe",
    "CORE_RTOS_SEM_SIGNAL": "0x40001770"
  }
}
