diff --git a/tests/test_dtim_counter.py b/tests/test_dtim_counter.py
index 0855b14..3f216c9 100644
--- a/tests/test_dtim_counter.py
+++ b/tests/test_dtim_counter.py
@@ -46,6 +46,31 @@ class DtimCounterTest(unittest.TestCase):
                          int(1_320_000 / 64_000_000 * pit.F_BUS)
                          - int(1_000_000 / 64_000_000 * pit.F_BUS))
 
+    def test_two_reads_in_one_native_block_advance_without_timer_service(self):
+        from emu.cftiming import CycleClock
+        from unicorn.m68k_const import UC_M68K_REG_D1
+        for fsys, mode, div, code_at in (
+                (pit.F_BUS, 0, 1, CODE), (200_000_000, 3, 1, CODE),
+                (250_000_000, 0x305, 64, CODE),
+                (pit.F_BUS, 0, 1, 0x40100000 - 44)):
+            with self.subTest(fsys=fsys, mode=mode, code_at=code_at):
+                m, timers = _machine(mode)
+                clock = CycleClock(m, fsys=fsys)
+                timers.ips = clock.fsys
+                timers.clock = 1000
+                timers.counter_clock = lambda: 1000 + clock.read_cycles()
+                code = READ_DTCN0 + bytes.fromhex('4e71') * 16
+                code += struct.pack('>HI', 0x2239, dtim.BASES[0] + dtim.DTCN)
+                m.uc.mem_write(code_at, code)
+                m.uc.emu_start(code_at, code_at + len(code))
+                first = m.uc.reg_read(UC_M68K_REG_D0)
+                second = m.uc.reg_read(UC_M68K_REG_D1)
+                self.assertEqual(first, 1000 * pit.F_BUS // (fsys * div))
+                self.assertEqual(second, (1000 + 1 + 16 * 6) * pit.F_BUS // (fsys * div))
+                self.assertEqual(timers.clock, 1000)  # no step/service between reads
+                self.assertEqual(clock.decode_mismatches, 0)
+                clock.close()
+
     def test_a_programmed_timer_uses_its_prescaler(self):
         dtmr = dtim.RST | (2 << 1) | (3 << 8)       # bus / 16, PS = 3 (/4)
         m, timers = _machine(dtmr)
