 recorded stack size and are not in the table.
+
+## Cycle-timed DMA timer reads
+
+**[C]** Cycle Sessions now timestamp DTCN reads at the current instruction,
+subtracting the unexecuted suffix of the precharged block. Two native loads
+separated by16 NOPs advance97 modeled cycles without timer service (previously0).
+`test_dtim_counter` covers clock ratios, prescalers and mapped-code boundaries.
+Legacy stepping/deadlines are unchanged; external DTIM2 pulses remain unmodeled.
diff --git a/emu/cftiming.py b/emu/cftiming.py
index d274d81..36c09b3 100644
--- a/emu/cftiming.py
+++ b/emu/cftiming.py
@@ -380,6 +380,8 @@ class CycleClock:
         self.left = None            # cycle budget, None = unbounded
         # (flags, addr, op) of every flagged instruction in decoded code.
         self.flagged = collections.Counter()
+        self._read_block = None
+        self._read_offsets = {}     # lazily decoded only for MMIO-read blocks
         self.on_new_block = None    # optional callable(Block), for strict mode
         self._orig_raise = m.raise_vector
         m.raise_vector = self._raise_vector
@@ -451,12 +453,53 @@ class CycleClock:
             misses = self.icache.touch(addr, size)
             cost += misses * self.miss_penalty
         self.cycles += cost
+        self._read_block = b
         self.instructions += b.n
         if addr in self.idle_addrs:
             self.idle_cycles += cost
         if left is not None:
             self.left = left - cost
 
+    def read_cycles(self):
+        """Estimated instruction-start time for a native MMIO read.
+
+        `cycles` precharges the complete entered block. Remove its unexecuted
+        suffix here; changing that accounting would change stepping/profiling.
+        Previous-flow, incoming stalls and optional cache-fill costs remain at
+        block entry. This is model time, not hardware memory-access timing.
+        """
+        from unicorn.m68k_const import UC_M68K_REG_PC
+        b = self._read_block
+        if b is None:
+            return self.cycles
+        pc = self.m.uc.reg_read(UC_M68K_REG_PC)
+        if not b.addr <= pc < b.fallthrough:
+            return self.cycles
+        offsets = self._read_offsets.get(b)
+        if offsets is None:
+            raw = bytes(self.m.uc.mem_read(b.addr, b.size)) + bytes(6)
+            read = cfisa.reader(raw, b.addr)
+            offsets = {}
+            at, static, stalls = b.addr, 0, 0
+            prev_w, prev_emac = -1, False
+            while at < b.fallthrough:
+                ins = cfisa.decode(read(at), at)
+                offsets[at] = (static, stalls)
+                cost = static_cost(ins, self.accel_max)
+                if prev_emac and ins.op in ('from_acc', 'from_emac'):
+                    cost = max(cost, EMAC_STORE_EXPOSED)
+                if at != b.addr:
+                    stalls += stall(prev_w, ins)
+                static += cost
+                prev_w, prev_emac = ins.writes, bool(ins.flags & EMAC_OP)
+                at += ins.length
+            self._read_offsets[b] = offsets
+        prefix = offsets.get(pc)
+        if prefix is None:
+            return self.cycles
+        return (self.cycles - b.static + prefix[0] -
+                (b.stalls - prefix[1] if self.use_stalls else 0))
+
     def _resolve(self, b, nxt):
         """Charge the flow instruction ending block `b` now that execution
         is known to continue at `nxt`."""
