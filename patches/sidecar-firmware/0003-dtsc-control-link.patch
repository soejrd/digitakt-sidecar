+void Output::ControlSet(uint32_t token, bool allowed) {
+  if ((token & 1u) == unsigned(allowed)) return;
+  __atomic_compare_exchange_n(&control_, &token, ((token + 2u) & ~1u) | unsigned(allowed),
+                              false, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE);
+}
 
