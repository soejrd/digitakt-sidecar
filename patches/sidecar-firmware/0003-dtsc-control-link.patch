+void Output::ControlClose() {
+  uint32_t old = ControlToken();
+  while (!__atomic_compare_exchange_n(&control_, &old, (old + 2u) & ~1u,
+                                      false, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) {}
