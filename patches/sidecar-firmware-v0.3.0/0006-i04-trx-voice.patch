diff --git a/pi/engine/dt_link.cpp b/pi/engine/dt_link.cpp
index e3ae102..34c03ab 100644
--- a/pi/engine/dt_link.cpp
+++ b/pi/engine/dt_link.cpp
@@ -1,13 +1,14 @@
-// DTSC session plumbing. Integrated output is silent unless the explicit
-// session-bound H02 diagnostic tone is enabled. Synthesis remains I04.
+// DTSC session plumbing and one native-rate TRX-B2 voice (I04 prototype).
 #include "dt_link.h"
 #include "dt_control/circle_link_adapter.h"
 #include "dt_control/h02_test_tone.h"
 #include "shared.h"
+#include "dt_control/trx_voice.h"
 #include <circle/util.h>
 namespace dt_link {
 static sc_circle_link link;
 static H02TestTone test_tone;
+static sc_trx_voice voice;
 static sc_frame snapshot;
 static uint32_t selected, losses, seen_loss;
 static bool initialized, installed;
@@ -31,15 +32,18 @@ static int Send(void *, const uint8_t *p, uint32_t n) {
   return 1; // complete record is owned by core 0's existing USB sender
 }
 static int Install(void *, const sc_frame *f) {
+  if (!sc_trx_install(&voice, f)) return 0;
   snapshot = *f; installed = true; return 1;
 }
 static void Clear(void *) {
   test_tone.Disable();
+  sc_trx_clear(&voice);
   installed = false; memset(&snapshot, 0, sizeof snapshot);
   g_Output.ControlClose();
 }
 static void Init() {
   if (!initialized) {
+    sc_trx_init(&voice);
     sc_circle_init(&link, Install, Send, Clear, 0, 750u);
     initialized = true;
   }
@@ -88,3 +92,11 @@ void RenderTestTone(int16_t (*out)[8], unsigned frames) {
 }
 
 }
+
+namespace dt_link {
+void RenderVoice(int16_t (*out)[8], unsigned frames) {
+  sc_frame f;
+  if (!State(&f)) { memset(out, 0, frames * sizeof *out); return; }
+  sc_trx_render(&voice, out, frames);
+}
+}
