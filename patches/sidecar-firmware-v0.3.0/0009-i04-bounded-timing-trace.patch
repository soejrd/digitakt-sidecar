+  TraceRecord r={};
+  if (trace_enabled && !trace_frozen) {
+    r.frame=*f; r.clock=(uint32_t)playout.clock;
+    r.rendered=clock_block*32u+clock_remainder;
+    r.requested=g_Output.RequestedFrames(); r.fifo=g_Output.Level();
+    r.previous_block=playout.last_block; r.previous_due=(uint32_t)playout.last_due;
+    r.queued=playout.write-playout.read;
+  }
+  const bool accepted=sc_playout_enqueue(&playout,f)!=0;
+  if (trace_enabled && !trace_frozen) {
+    r.accepted=accepted; r.reason=accepted ? 0 : playout.failure.code;
+    trace[trace_write++ % 128]=r;
+    if (!accepted) trace_frozen=true;
