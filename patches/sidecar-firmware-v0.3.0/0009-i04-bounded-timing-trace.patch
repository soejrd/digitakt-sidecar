 }
 }
+
+namespace dt_link {
+void TraceEnable(bool on) {
+  VoiceCommand(false);
+  trace_enabled=on;
+  if (on) { trace_write=0; trace_frozen=false; }
+}
+unsigned TraceCount() { return trace_write<128u ? trace_write : 128u; }
+bool TraceFrozen() { return trace_frozen; }
+bool TraceRead(unsigned index, TraceRecord *out) {
+  if (!out || index>=TraceCount()) return false;
+  const unsigned oldest=trace_write>128u ? trace_write-128u : 0;
+  *out=trace[(oldest+index)%128u]; return true;
+}
+}
diff --git a/pi/engine/dt_link.h b/pi/engine/dt_link.h
index 157426e..e65e5ee 100644
--- a/pi/engine/dt_link.h
