 namespace dt_link { void VoiceFault(unsigned out[6]); } // last fault survives session reset
+
+namespace dt_link {
+struct TraceRecord {
+  sc_frame frame;
+  uint32_t clock, rendered, requested, fifo, previous_block, previous_due;
+  uint32_t queued, accepted, reason;
+};
+void TraceEnable(bool on); // core 3; enabling forces mute
+unsigned TraceCount();
+bool TraceFrozen();
+bool TraceRead(unsigned index, TraceRecord *out); // oldest retained record first
+}
