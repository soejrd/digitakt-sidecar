diff --git a/pi/engine/dt_link.cpp b/pi/engine/dt_link.cpp
new file mode 100644
index 0000000..1c446ea
--- /dev/null
+++ b/pi/engine/dt_link.cpp
@@ -0,0 +1,70 @@
+// DTSC session plumbing. Synthesis is I04; until an engine consumes State(),
+// the integrated mode produces silence while still acknowledging controls.
+#include "dt_link.h"
+#include "dt_control/circle_link_adapter.h"
+#include "shared.h"
+#include <circle/util.h>
+namespace dt_link {
+static sc_circle_link link;
+static sc_frame snapshot;
+static uint32_t selected, losses, seen_loss;
+static bool initialized, installed;
+static uint32_t clock_block;
+
+void Select() {
+  __atomic_add_fetch(&losses, 1u, __ATOMIC_RELEASE);
+  g_Output.ControlClose();
+  __atomic_store_n(&selected, 1u, __ATOMIC_RELEASE);
+}
+bool Selected() { return __atomic_load_n(&selected, __ATOMIC_ACQUIRE) != 0; }
+void Lost() {
+  if (!Selected()) return;
+  __atomic_add_fetch(&losses, 1u, __ATOMIC_RELEASE);
+  g_Output.ControlClose();
+}
+static int Send(void *, const uint8_t *p, uint32_t n) {
+  if (n + 2u > kMidiOutBytes - g_MidiOut.size()) return 0;
+  g_MidiOut.push(n & 255u); g_MidiOut.push(n >> 8);
+  for (uint32_t i = 0; i < n; ++i) g_MidiOut.push(p[i]);
+  return 1; // complete record is owned by core 0's existing USB sender
+}
+static int Install(void *, const sc_frame *f) {
+  snapshot = *f; installed = true; return 1;
+}
+static void Clear(void *) {
+  installed = false; memset(&snapshot, 0, sizeof snapshot);
+  g_Output.ControlClose();
+}
+static void Init() {
+  if (!initialized) {
+    sc_circle_init(&link, Install, Send, Clear, 0, 750u);
+    initialized = true;
+  }
+}
+bool SysEx(const uint8_t *p, unsigned n) {
+  if (!Selected() || !sc_is_dtsc(p,n)) return false;
+  Init();
+  for (unsigned i = 0; i < n; ++i) sc_circle_midi_byte(&link,p[i]);
+  sc_circle_process(&link, 1u);
+  return true;
+}
+void Poll(uint32_t block) {
+  uint32_t token, lost;
+  if (!Selected()) return;
+  Init(); clock_block = block;
+  token = g_Output.ControlToken();
+  sc_circle_advance_block(&link,clock_block);
+  lost = __atomic_load_n(&losses, __ATOMIC_ACQUIRE);
+  if (lost != seen_loss) {
+    seen_loss = lost;
+    sc_circle_transport_lost(&link, SC_REASON_TRANSPORT);
+  }
+  sc_circle_process(&link, 128u);
+  g_Output.ControlSet(token, sc_circle_audio_allowed(&link) &&
+                            lost == __atomic_load_n(&losses, __ATOMIC_ACQUIRE));
+}
+bool State(sc_frame *out) {
+  if (!installed || !sc_circle_audio_allowed(&link)) return false;
+  *out = snapshot; return true;
+}
+}
