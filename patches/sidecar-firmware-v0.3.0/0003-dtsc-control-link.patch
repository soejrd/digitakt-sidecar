+++ b/pi/engine/dt_link.h
@@ -0,0 +1,12 @@
+// Portable DTSC control protocol; no device-firmware addresses or code.
+#pragma once
+#include <stdint.h>
+#include "dt_control/link.h"
+namespace dt_link {
+void Select();                    // core 0: descriptor-matched integrated device
+bool Selected();
+void Lost();                      // core 0: transport removal/receive loss
+bool SysEx(const uint8_t *, unsigned); // core 3: consumes DTSC only
+void Poll(uint32_t block);         // core 3: bounded protocol work + output gate
+bool State(sc_frame *out);         // core 3: I04 engine's preallocated input
+}
