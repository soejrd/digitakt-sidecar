diff --git a/pi/engine/dt_link.cpp b/pi/engine/dt_link.cpp
index 1c446ea..df684de 100644
--- a/pi/engine/dt_link.cpp
+++ b/pi/engine/dt_link.cpp
@@ -1,11 +1,13 @@
-// DTSC session plumbing. Synthesis is I04; until an engine consumes State(),
-// the integrated mode produces silence while still acknowledging controls.
+// DTSC session plumbing. Integrated output is silent unless the explicit
+// session-bound H02 diagnostic tone is enabled. Synthesis remains I04.
 #include "dt_link.h"
 #include "dt_control/circle_link_adapter.h"
+#include "dt_control/h02_test_tone.h"
 #include "shared.h"
 #include <circle/util.h>
 namespace dt_link {
 static sc_circle_link link;
+static H02TestTone test_tone;
 static sc_frame snapshot;
 static uint32_t selected, losses, seen_loss;
 static bool initialized, installed;
@@ -32,6 +34,7 @@ static int Install(void *, const sc_frame *f) {
   snapshot = *f; installed = true; return 1;
 }
 static void Clear(void *) {
+  test_tone.Disable();
   installed = false; memset(&snapshot, 0, sizeof snapshot);
   g_Output.ControlClose();
 }
@@ -67,4 +70,15 @@ bool State(sc_frame *out) {
   if (!installed || !sc_circle_audio_allowed(&link)) return false;
   *out = snapshot; return true;
 }
+bool TestToneCommand(bool on) {
+  sc_frame f;
+  bool allowed = State(&f);
+  return test_tone.Enable(on, allowed, allowed ? f.session : 0);
+}
+void RenderTestTone(int16_t (*out)[8], unsigned frames) {
+  sc_frame f;
+  bool allowed = State(&f);
+  test_tone.Render(out, frames, allowed, allowed ? f.session : 0);
+}
+
 }
